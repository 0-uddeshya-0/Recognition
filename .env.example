# Recognition UI — optional Devin mode. Without these the UI runs locally only.
DEVIN_API_KEY=apk_user_...        # Devin → Settings → API Keys (v1 key); a cog_ v3 key is NOT accepted by the v1 endpoints
# DEVIN_PLAYBOOK_ID=              # optional: id of playbooks/detailing-ui.devin.md created in the Devin org; otherwise the playbook text is inlined in the prompt
# DEVIN_MAX_ACU=5                 # ACU ceiling per session
# GITHUB_REPO=owner/name          # defaults to the origin remote
# GITHUB_TOKEN=                   # optional: merge PRs via the REST API instead of `gh pr merge`
# RECOGNITION_JOBS_DIR=out/ui-jobs
# RECOGNITION_UI_HOST=127.0.0.1
# RECOGNITION_UI_PORT=8000
